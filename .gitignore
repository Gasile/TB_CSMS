# ==========================================
# 1. Frontend (React / Node.js)
# ==========================================
# Exclut les dépendances lourdes (elles seront réinstallées via npm install)
node_modules/
# Exclut les dossiers de compilation finaux
build/
dist/
# Exclut les journaux d'erreurs d'installation
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 2. Services (Python)
# ==========================================
# Exclut le cache de compilation de Python
__pycache__/
*.py[cod]
*$py.class
# Exclut ton environnement virtuel local (très important !)
ocpp_env/
venv/
env/

# ==========================================
# 3. Variables d'environnement & Secrets
# ==========================================
# Exclut TOUS les fichiers contenant des mots de passe ou des clés d'API
.env
.env.local
.env.*.local
*.pem

# ==========================================
# 4. Outils de développement (IDE & OS)
# ==========================================
# Exclut les dossiers de configuration de VS Code
.vscode/
# Exclut les fichiers cachés générés par Windows ou macOS
.DS_Store
Thumbs.db

# ==========================================
# 5. Données Docker & Bases de données
# ==========================================
data/

# ==========================================
# 6. Outils en ligne de commande (CLI)
# ==========================================
citrineos-config/hasura/hasura.exe
citrineos-config/hasura/hasura

# ==========================================
# 5. CitrineOS & Monorepo (Turborepo)
# ==========================================
# CitrineOS utilise Turborepo pour gérer ses packages. 
# Ce dossier contient des caches de build très lourds et inutiles à historiser.
.turbo/

# ==========================================
# 6. Docker & Données de la Base de Données
# ==========================================
# Exclut le dossier où PostgreSQL écrit ses données réelles sur le disque.
# (Très important pour éviter de commiter des gigaoctets de logs SQL ou de tables de test)
data/
pg_data/
